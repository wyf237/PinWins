<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PinWins.Views.SettingsWindow"
        Title="PinWins 设置"
        Width="560" Height="580"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="18">

      <StackPanel Spacing="4">
        <TextBlock Text="PinWins 窗口置顶工具" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="把鼠标指向任意窗口，按下快捷键即可将其置顶并绘制醒目边框。"
                   Foreground="#8A8A8A" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="全局快捷键" FontWeight="SemiBold" />
        <Border Name="HotkeyBox" CornerRadius="6" Padding="14" MinHeight="46"
                BorderThickness="1" BorderBrush="#D9D9D9" Background="#F7F8FA" Cursor="Hand">
          <TextBlock Name="HotkeyText" Text="未设置" FontSize="16" VerticalAlignment="Center" />
        </Border>
        <TextBlock Name="HotkeyHint"
                   Text="点击上方区域，然后按下组合键（必须包含 Ctrl / Alt / Shift / Win 之一，Esc 取消）"
                   Foreground="#8A8A8A" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="边框颜色" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <ColorPicker Name="BorderColorPicker" Width="260" />
          <TextBlock Name="ColorHexText" VerticalAlignment="Center" Foreground="#666666" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="边框宽度" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Slider Name="BorderWidthSlider" Width="300" Minimum="1" Maximum="10"
                  TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
          <TextBlock Name="BorderWidthText" VerticalAlignment="Center" Foreground="#666666" />
        </StackPanel>
        <TextBlock Text="默认 6 px，范围 1–10 px。数值越大越醒目，过宽会遮挡窗口边缘内容。"
                   Foreground="#8A8A8A" TextWrapping="Wrap" />
      </StackPanel>

      <CheckBox Name="MultiWindowCheck"
                Content="允许多个窗口同时置顶（多窗口使用不同颜色的边框区分）" />

      <TextBlock Name="ErrorText" Foreground="#D93026" TextWrapping="Wrap" IsVisible="False" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
        <Button Name="CancelBtn" Content="取消" MinWidth="88" Click="OnCancelClick" />
        <Button Name="SaveBtn" Content="保存" MinWidth="88"
                Background="#0064FA" Foreground="White" Click="OnSaveClick" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Window>
